{
  "name": "vitanet-desktop",
  "version": "1.0.0",
  "description": "VITANET Business Management System",
  "main": "main.cjs",
  "author": "VITANET",
  "license": "UNLICENSED",
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vitanet.staff",
    "productName": "VITANET",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VITANET-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VITANET"
    }
  }
}